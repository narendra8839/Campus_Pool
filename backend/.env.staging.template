# Server Configuration
PORT=5000
NODE_ENV=staging

# Neon PostgreSQL Database Connection String
# Use a separate Neon branch or database for staging
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-staging-branch-aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-staging-branch.aws.neon.tech/neondb?sslmode=require"

# JWT Secret & Expiry
# Use a strong, randomly generated secret in staging
JWT_SECRET=your_staging_jwt_secret_here_change_me
JWT_EXPIRES_IN=30d

# Optional: College Domain Restriction (e.g. vit.edu)
ALLOWED_EMAIL_DOMAIN=@vit.edu

# Note: This file is for staging environment.
# Do not commit this file to version control.
# Copy to .env on the staging server and fill in actual secrets.