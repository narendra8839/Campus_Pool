# Server Configuration
PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database Connection String
# For development, you can use a local PostgreSQL or a Neon dev branch
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-your-dev-branch-aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-your-dev-branch.aws.neon.tech/neondb?sslmode=require"

# JWT Secret & Expiry
# In development, you can use a simple secret, but make sure to change it for staging/prod
JWT_SECRET=dev_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=30d

# Optional: College Domain Restriction (e.g. vit.edu)
ALLOWED_EMAIL_DOMAIN=@vit.edu
NOMINATIM_USER_AGENT="CampusPool/1.0 (contact: your-email@example.com)"
OSRM_BASE_URL=https://router.project-osrm.org

# Note: This file is for development purposes only.
# Do not commit this file to version control.
# Copy to .env and fill in your actual secrets.