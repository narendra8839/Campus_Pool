# Server Configuration
PORT=5000
NODE_ENV=production

# Neon PostgreSQL Database Connection String
# Use the production Neon database
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-production-branch-aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-production-branch.aws.neon.tech/neondb?sslmode=require"

# JWT Secret & Expiry
# Use a strong, randomly generated secret in production (minimum 32 characters)
JWT_SECRET=your_production_jwt_secret_here_change_me_and_make_it_long
JWT_EXPIRES_IN=30d

# Optional: College Domain Restriction (e.g. vit.edu)
ALLOWED_EMAIL_DOMAIN=@vit.edu

# Note: This file is for production environment.
# Do not commit this file to version control.
# Copy to .env on the production server and fill in actual secrets.
# Consider using a secrets manager or environment variables in your hosting platform.